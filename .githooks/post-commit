#!/bin/sh
# Rebuilds assets/Ethan-Sie-Portfolio.pdf whenever a commit touches
# whatever the PDF is built from — project content, images/papers, or
# the build script itself. Never blocks a commit: it always exits 0.

changed=$(git diff --name-only HEAD~1 HEAD 2>/dev/null)

if echo "$changed" | grep -qE '^(js/data\.js|assets/img/|assets/papers/|scripts/build-pdf\.js)'; then
  echo "portfolio content changed — rebuilding PDF..."
  npm run --silent build:pdf || echo "warning: PDF build failed (commit was not affected)"
fi

exit 0
