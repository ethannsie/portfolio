#!/bin/sh
# Rebuilds generated PDF-derived assets and stages them so they ship in
# the same commit as whatever content produced them. Never blocks a
# commit: build failures print a warning but always exit 0.

changed=$(git diff --cached --name-only)

if echo "$changed" | grep -qE '^(js/data\.js|assets/img/|assets/papers/|scripts/build-pdf\.js)'; then
  echo "portfolio content changed — rebuilding PDF..."
  if npm run --silent build:pdf; then
    git add assets/Ethan-Sie-Portfolio.pdf
  else
    echo "warning: PDF build failed — commit will proceed without an updated PDF"
  fi
fi

if echo "$changed" | grep -qE '^(assets/notes/|scripts/build-notes\.js)'; then
  echo "notes changed — rebuilding note thumbnails..."
  if npm run --silent build:notes; then
    git add -A assets/notes/thumbs js/notes-data.js
  else
    echo "warning: notes build failed — commit will proceed without updated notes"
  fi
fi

exit 0
